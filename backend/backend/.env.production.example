# ============================================================
# DRISHTI SETU — Production Backend Environment Configuration
# Target: Azure App Service / Azure Container Apps / Supabase Cloud
# ============================================================

# Supabase Production Instance (PostgreSQL + PostGIS)
SUPABASE_URL=https://your-production-instance.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-admin-key

# PostgreSQL Direct Connection String (for SQLAlchemy connection pool)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Cryptographic Token Signing Key (Min 256-bit entropy)
JWT_SECRET=generate-a-strong-64-character-hex-secret-in-production

# Security & Compliance Flags
# Set to false for strict production verification (requires email activation)
DEMO_MODE=false
CORS_ORIGINS=https://drishti-setu.vercel.app,https://your-domain.gov.in

# Server Port & Logging
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info
