# ============================================================
# DRISHTI SETU — Backend Environment Configuration Template
# ============================================================
# Copy this file to .env and insert your real credentials.
# Do NOT commit production secrets to public version control.
# ============================================================

PORT=8000
HOST=0.0.0.0

# Supabase Cloud Project Credentials (from your Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key-here

# Secure JWT Secret for authentication signing
JWT_SECRET=your-secure-jwt-secret-key-here

# Offline fallback demo mode
DEMO_MODE=true
